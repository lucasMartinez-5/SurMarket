<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/loginFragment"
    >
    <fragment
        android:id="@+id/loginFragment"
        android:name="bo.edu.uajms.lucasmartinez.surmarket.FragmentLogin"
        android:label="@string/labelLoginFragment"
        tools:layout="@layout/fragment_login"
        >
        <action
            android:id="@+id/action_login_to_products_List"
            app:destination="@+id/productsListFragment"
            />
    </fragment>
    <fragment
        android:id="@+id/productsListFragment"
        android:name="bo.edu.uajms.lucasmartinez.surmarket.FragmentProductsList"
        android:label="@string/labelProductsListFragment"
        tools:layout="@layout/fragment_products_list"
        >
        <action
            android:id="@+id/action_product_list_to_add_product"
            app:destination="@+id/addProductFragment"
            />
        <action
            android:id="@+id/action_products_list_to_cart"
            app:destination="@+id/cartFragment"
            />
        <action
            android:id="@+id/action_products_list_to_profile"
            app:destination="@+id/profileFragment"
            />
    </fragment>
    <fragment
        android:id="@+id/addProductFragment"
        android:name="bo.edu.uajms.lucasmartinez.surmarket.FragmentAddProduct"
        android:label="@string/labelAddProductsFragment"
        tools:layout="@layout/fragment_products_list"
        >
    </fragment>
    <fragment
        android:id="@+id/cartFragment"
        android:name="bo.edu.uajms.lucasmartinez.surmarket.FragmentCart"
        android:label="@string/cart_title"
        tools:layout="@layout/fragment_cart"
        >
        <action
            android:id="@+id/action_cart_to_products_list"
            app:destination="@+id/productsListFragment"
            />
        <action
            android:id="@+id/action_cart_to_profile"
            app:destination="@+id/profileFragment"
            />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="bo.edu.uajms.lucasmartinez.surmarket.FragmentProfile"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile"
        >
        <action
            android:id="@+id/action_profile_to_products_list"
            app:destination="@+id/productsListFragment"
            />
        <action
            android:id="@+id/action_profile_to_cart"
            app:destination="@+id/cartFragment"
            />
    </fragment>
</navigation>